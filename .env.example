# Copy to .env and fill in. Never commit .env.

# --- Database (docker compose defaults) ---
# On Netlify, connecting Netlify DB sets NETLIFY_DATABASE_URL(_UNPOOLED); the app and
# scripts/netlify-build.sh fall back to them when DATABASE_URL / DIRECT_URL are unset.
DATABASE_URL="postgresql://pulse:pulse@localhost:5432/pulse"
# Neon: set DIRECT_URL to the non-pooled connection string (used by migrations).
DIRECT_URL="postgresql://pulse:pulse@localhost:5432/pulse"

# --- Auth.js ---
# Generate with: pnpm dlx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-me-with-a-long-random-string"
# Optional locally. GitHub OAuth app callback: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# --- Email (magic links + notifications). Mailpit catches these locally. ---
EMAIL_SERVER="smtp://localhost:1025"
EMAIL_FROM="Pulse <no-reply@pulse.local>"

# --- App ---
APP_URL="http://localhost:3000"
# Shared secret that GitHub Actions sends to /api/cron (Authorization: Bearer ...)
CRON_SECRET="replace-me"
